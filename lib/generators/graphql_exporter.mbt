// MoonBit Data Contract - GraphQL SDL Exporter

///|
pub fn map_type_to_graphql(data_type : @types.DataType) -> String {
  match data_type {
    Primitive(PBool) => "Boolean"
    Primitive(PInt) => "Int"
    Primitive(PInt64) => "Float"
    Primitive(PDouble) => "Float"
    Primitive(PString) => "String"
    Primitive(PBytes) => "String"
    Primitive(PTimestamp) => "String"
    EnumDef(name, _) => name
    ArrayDef(inner) => "[" + map_type_to_graphql(inner) + "]"
    MapDef(_, _) => "String"
    OptionalDef(inner) => map_type_to_graphql(inner)
    StructDef(name, _) => name
    UnionDef(_) => "String"
  }
}

///|
pub fn export_to_graphql_sdl(schema : @types.ContractSchema) -> String {
  let mut sdl = "# Generated by MoonBit Data Contract Tool\n"
  sdl = sdl + "type " + schema.header.name + " {\n"

  for i = 0; i < schema.fields.length(); i = i + 1 {
    let f = schema.fields[i]
    let base_t = map_type_to_graphql(f.field_type)
    let req_mark = if f.required { "!" } else { "" }

    if f.description.length() > 0 {
      sdl = sdl + "  \"\"\" " + f.description + " \"\"\"\n"
    }
    sdl = sdl + "  " + f.name + ": " + base_t + req_mark + "\n"
  }

  sdl = sdl + "}\n"
  sdl
}
