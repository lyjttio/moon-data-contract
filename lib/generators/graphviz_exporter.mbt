// MoonBit Data Contract - Graphviz DOT ER Diagram & Dependency Exporter

///|
pub fn export_to_graphviz_dot(schema : @types.ContractSchema) -> String {
  let mut dot = "// Generated by MoonBit Data Contract Tool\n"
  dot = dot + "digraph " + schema.header.name + " {\n"
  dot = dot + "  node [shape=none, fontname=\"Helvetica,Arial,sans-serif\"];\n"
  dot = dot + "  rankdir=LR;\n\n"

  dot = dot + "  " + schema.header.name + " [label=<\n"
  dot = dot +
    "    <table border=\"0\" cellborder=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
  dot = dot +
    "      <tr><td bgcolor=\"#1e293b\"><font color=\"#38bdf8\"><b>" +
    schema.header.name +
    "</b> (v" +
    schema.header.version +
    ")</font></td></tr>\n"

  for i = 0; i < schema.fields.length(); i = i + 1 {
    let f = schema.fields[i]
    let pk_badge = if f.primary_key { " 🔑 [PK]" } else { "" }
    let req_badge = if f.required { " *" } else { "" }
    let bg_color = if i % 2 == 0 { "#0f172a" } else { "#1e293b" }

    dot = dot +
      "      <tr><td bgcolor=\"" +
      bg_color +
      "\" align=\"left\"><font color=\"#f8fafc\">" +
      f.name +
      req_badge +
      ": " +
      f.field_type.to_string() +
      pk_badge +
      "</font></td></tr>\n"
  }

  dot = dot + "    </table>\n  >];\n"
  dot = dot + "}\n"
  dot
}
