// MoonBit Data Contract - Protobuf v3 Exporter

pub fn map_type_to_proto(data_type : @types.DataType) -> String {
  match data_type {
    Primitive(PBool) => "bool"
    Primitive(PInt) => "int32"
    Primitive(PInt64) => "int64"
    Primitive(PDouble) => "double"
    Primitive(PString) => "string"
    Primitive(PBytes) => "bytes"
    Primitive(PTimestamp) => "int64"
    EnumDef(name, _) => name
    ArrayDef(inner) => "repeated " + map_type_to_proto(inner)
    MapDef(k, v) => "map<" + map_type_to_proto(k) + ", " + map_type_to_proto(v) + ">"
    OptionalDef(inner) => "optional " + map_type_to_proto(inner)
    StructDef(name, _) => name
    UnionDef(_) => "string"
  }
}

pub fn export_to_protobuf(schema : @types.ContractSchema) -> String {
  let mut proto = "// Generated by MoonBit Data Contract Tool\n"
  proto = proto + "syntax = \"proto3\";\n\n"
  proto = proto + "package " + schema.header.space_name + ";\n\n"
  proto = proto + "message " + schema.header.name + " {\n"

  for i = 0; i < schema.fields.length(); i = i + 1 {
    let f = schema.fields[i]
    let type_str = map_type_to_proto(f.field_type)
    let tag_num = if f.id > 0 { f.id } else { i + 1 }
    proto = proto + "  " + type_str + " " + f.name + " = " + tag_num.to_string() + ";"
    if f.description.length() > 0 {
      proto = proto + " // " + f.description
    }
    proto = proto + "\n"
  }

  proto = proto + "}\n"
  proto
}
