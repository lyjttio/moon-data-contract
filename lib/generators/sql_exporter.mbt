// MoonBit Data Contract - SQL DDL Exporter (MySQL & PostgreSQL)

pub fn map_type_to_sql(data_type : @types.DataType, dialect : String) -> String {
  match data_type {
    Primitive(PBool) => if dialect == "postgres" { "BOOLEAN" } else { "TINYINT(1)" }
    Primitive(PInt) => "INT"
    Primitive(PInt64) => "BIGINT"
    Primitive(PDouble) => if dialect == "postgres" { "DOUBLE PRECISION" } else { "DOUBLE" }
    Primitive(PString) => "VARCHAR(255)"
    Primitive(PBytes) => if dialect == "postgres" { "BYTEA" } else { "BLOB" }
    Primitive(PTimestamp) => if dialect == "postgres" { "TIMESTAMP WITH TIME ZONE" } else { "DATETIME" }
    EnumDef(_, _) => "VARCHAR(64)"
    ArrayDef(_) => if dialect == "postgres" { "JSONB" } else { "JSON" }
    MapDef(_, _) => if dialect == "postgres" { "JSONB" } else { "JSON" }
    OptionalDef(inner) => map_type_to_sql(inner, dialect)
    StructDef(_, _) => if dialect == "postgres" { "JSONB" } else { "JSON" }
    UnionDef(_) => "VARCHAR(255)"
  }
}

pub fn export_to_sql_ddl(
  schema : @types.ContractSchema,
  dialect~ : String = "mysql"
) -> String {
  let table_name = schema.header.name
  let mut sql = "-- SQL DDL Generated by MoonBit Data Contract Tool\n"
  sql = sql + "-- Schema ID: " + schema.header.id + " | Version: " + schema.header.version + "\n"
  sql = sql + "CREATE TABLE IF NOT EXISTS `" + table_name + "` (\n"

  let primary_keys : Array[String] = []

  for i = 0; i < schema.fields.length(); i = i + 1 {
    let f = schema.fields[i]
    let col_type = map_type_to_sql(f.field_type, dialect)
    sql = sql + "  `" + f.name + "` " + col_type

    if f.required {
      sql = sql + " NOT NULL"
    } else {
      sql = sql + " NULL"
    }

    if f.description.length() > 0 && dialect == "mysql" {
      sql = sql + " COMMENT '" + f.description + "'"
    }

    if f.primary_key {
      primary_keys.push(f.name)
    }

    if i < schema.fields.length() - 1 || primary_keys.length() > 0 {
      sql = sql + ",\n"
    } else {
      sql = sql + "\n"
    }
  }

  if primary_keys.length() > 0 {
    sql = sql + "  PRIMARY KEY ("
    for i = 0; i < primary_keys.length(); i = i + 1 {
      if i > 0 { sql = sql + ", " }
      sql = sql + "`" + primary_keys[i] + "`"
    }
    sql = sql + ")\n"
  }

  sql = sql + ");\n"
  sql
}
