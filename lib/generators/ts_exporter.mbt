// MoonBit Data Contract - TypeScript Type Exporter

///|
pub fn map_type_to_ts(data_type : @types.DataType) -> String {
  match data_type {
    Primitive(PBool) => "boolean"
    Primitive(PInt) | Primitive(PInt64) | Primitive(PDouble) => "number"
    Primitive(PString) | Primitive(PBytes) | Primitive(PTimestamp) => "string"
    EnumDef(_, vals) => {
      let mut res = ""
      for i = 0; i < vals.length(); i = i + 1 {
        if i > 0 {
          res = res + " | "
        }
        res = res + "\"" + vals[i] + "\""
      }
      if vals.length() == 0 {
        "string"
      } else {
        res
      }
    }
    ArrayDef(inner) => map_type_to_ts(inner) + "[]"
    MapDef(k, v) =>
      "Record<" + map_type_to_ts(k) + ", " + map_type_to_ts(v) + ">"
    OptionalDef(inner) => map_type_to_ts(inner) + " | null"
    StructDef(name, _) => name
    UnionDef(types) => {
      let mut res = ""
      for i = 0; i < types.length(); i = i + 1 {
        if i > 0 {
          res = res + " | "
        }
        res = res + map_type_to_ts(types[i])
      }
      res
    }
  }
}

///|
pub fn export_to_typescript(schema : @types.ContractSchema) -> String {
  let mut ts = "// Generated by MoonBit Data Contract Tool\n"
  ts = ts + "export interface " + schema.header.name + " {\n"

  for i = 0; i < schema.fields.length(); i = i + 1 {
    let f = schema.fields[i]
    let opt_flag = if f.required { "" } else { "?" }
    let type_str = map_type_to_ts(f.field_type)

    if f.description.length() > 0 {
      ts = ts + "  /** " + f.description + " */\n"
    }
    ts = ts + "  " + f.name + opt_flag + ": " + type_str + ";\n"
  }

  ts = ts + "}\n"
  ts
}
